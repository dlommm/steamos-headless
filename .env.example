# Copy to .env and edit (used by docker-compose.yml in the repo root).

# Image to run. Defaults to the one GitLab CI publishes. Use a release tag
# (e.g. 2026.09.28.3) or steamos-3.8 instead of latest to stay on a version.
IMAGE_REPO=registry.ohhcloud.com/dlomm/arch-steam-headless
IMAGE_TAG=latest

# auto (default) detects the GPU. Only set nvidia or amd on hosts with both.
GPU_VENDOR=auto

# Resolution Steam starts at before anyone connects. Each Moonlight client
# switches it to that device's own resolution/refresh on connect.
STEAMOS_RESOLUTION=1920x1080
STEAMOS_REFRESH=60

# Sunshine web UI login (https://<host>:47990). Leave SUNSHINE_PASS empty to
# create the account in the web UI on first visit instead.
SUNSHINE_USER=admin
SUNSHINE_PASS=

TZ=UTC

# Only for local builds (docker compose build):
# "latest" = highest numbered SteamOS release (may be a preview), or pin e.g. 3.8.
STEAMOS_VERSION=latest
# "latest" or a Sunshine tag without the v, e.g. 2026.914.233613
SUNSHINE_VERSION=latest
