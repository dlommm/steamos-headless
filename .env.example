# Copy to .env and edit.

# Use the images built by GitLab CI instead of building locally: set this to
# the project's registry path (GitLab > Deploy > Container registry), e.g.
# IMAGE_REPO=<registry-host>/dlomm/arch-steam-headless
IMAGE_REPO=steamos-docker

# SteamOS repo version: "latest" (highest numbered release, may be a preview)
# or pin, e.g. 3.8 for the current stable.
STEAMOS_VERSION=latest
# Sunshine release: "latest" or a tag without the v, e.g. 2026.914.233613
SUNSHINE_VERSION=latest

# Resolution Steam starts at before anyone connects. Each Moonlight client
# switches it to that device's own resolution/refresh on connect.
STEAMOS_RESOLUTION=1920x1080
STEAMOS_REFRESH=60

# Sunshine web UI login (https://<host>:47990). Leave SUNSHINE_PASS empty to
# create the account in the web UI on first visit instead.
SUNSHINE_USER=admin
SUNSHINE_PASS=

TZ=UTC
