#!/bin/bash
# First-run Sunshine config (as deck). Existing files are never overwritten,
# so anything changed in the web UI sticks.
set -euo pipefail

cfg=/home/deck/.config/sunshine
mkdir -p "$cfg" /home/deck/.local/state

if [[ ! -e "$cfg/sunshine.conf" ]]; then
    {
        echo "sunshine_name = ${SUNSHINE_NAME:-SteamOS-Headless}"
        echo "capture = wlr"
        echo "system_tray = disabled"
        echo "file_apps = $cfg/apps.json"
        echo "origin_web_ui_allowed = lan"
    } > "$cfg/sunshine.conf"
fi

[[ -e "$cfg/apps.json" ]] || cp /etc/steamos-headless/apps.json "$cfg/apps.json"
# Older images shipped "Desktop" without a command (it just showed the screen).
# It now opens Desktop Mode; update that entry only if it's still untouched.
if jq -e '.apps[] | select(.name == "Desktop" and (has("cmd") | not) and (has("prep-cmd") | not))' \
        "$cfg/apps.json" >/dev/null 2>&1; then
    jq '(.apps[] | select(.name == "Desktop" and (has("cmd") | not))) += {
            "cmd": "/usr/local/bin/steamos-session desktop",
            "auto-detach": "true", "wait-all": "false", "exit-timeout": "5"}' \
        "$cfg/apps.json" > "$cfg/apps.json.new" && mv "$cfg/apps.json.new" "$cfg/apps.json"
fi

if [[ -n "${SUNSHINE_PASS:-}" ]]; then
    sunshine "$cfg/sunshine.conf" --creds "${SUNSHINE_USER:-admin}" "$SUNSHINE_PASS" >/dev/null 2>&1 || true
fi
