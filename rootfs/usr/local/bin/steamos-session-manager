#!/bin/bash
# The container's session manager, standing in for SteamOS's (SDDM + the
# gamescope/plasma sessions). Runs as deck on the sway display and keeps
# exactly one session going:
#   gamescope  Gaming Mode: Steam Big Picture in gamescope (the default)
#   plasma     Desktop Mode: KDE Plasma with the Steam desktop client
# When a session ends it starts the next one: whatever was asked for through
# steamos-session-control (SteamOS's own holo-session-select, via the
# container's steamosctl), else the default login mode, else Gaming Mode. So
# Switch to Desktop, Return to Gaming Mode, Steam's Restart and a Steam that
# quits or crashes all come back on screen, like on a Deck.
set -uo pipefail

state=/run/user/1000/steamos-session
login_mode=/home/deck/.config/steamos-docker/login-mode
log=/home/deck/.local/state/steamos-session.log
mkdir -p "$state" "$(dirname "$log")"
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-1}

note() { echo "[session] $*" | tee -a "$log"; }

next_session() {
    local s
    s=$(cat "$state/next" 2>/dev/null || true)
    rm -f "$state/next"
    if [[ -z "$s" && "$(cat "$login_mode" 2>/dev/null)" == desktop ]]; then s=plasma; fi
    [[ "$s" == plasma ]] && echo plasma || echo gamescope
}

# Moonlight's resolution, set by steamos-session when a client connects;
# before that, the last client's (kept across container starts), else the
# configured start size.
current_mode() {
    local m
    m=$(cat "$state/mode" 2>/dev/null || cat /home/deck/.config/steamos-docker/client-mode 2>/dev/null)
    [[ "$m" =~ ^[0-9]+x[0-9]+@[0-9]+$ ]] || m="${STEAMOS_RESOLUTION:-1920x1080}@${STEAMOS_REFRESH:-60}"
    echo "$m"
}

# Gaming Mode, the way SteamOS's systemd user units run it:
#   gamescope-session.service  Valve's /usr/lib/steamos/gamescope-session (its
#                              environment for Steam, then gamescope)
#   steam-launcher.service     Valve's steam-launcher, restarted whenever Steam
#                              exits while gamescope runs (the target
#                              "Upholds" it), with the short-session tracker
#   gamescope-mangoapp, ibus-gamescope, steam-notif-daemon
# All but the first get the environment gamescope-session writes to
# $XDG_RUNTIME_DIR/gamescope-environment once gamescope is up.
run_gamescope() {
    local mode W H R rt=/run/user/1000 bin="$state/bin" envfile gs pids=() envs=()
    mode=$(current_mode)
    IFS='x@' read -r W H R <<<"$mode"
    echo "$mode" > "$state/running-mode"
    envfile="$rt/gamescope-environment"
    rm -f "$envfile" "$state/ending"

    # Valve's session drives the Deck's panel (DRM mode, eDP-1, 1280x800);
    # nested in sway, swap those flags for the Moonlight client's resolution.
    mkdir -p "$bin"
    cat > "$bin/gamescope" <<EOF
#!/bin/bash
args=()
while [[ \$# -gt 0 ]]; do
    case "\$1" in
        --generate-drm-mode|-O|--prefer-output|-w|-h|--nested-width|--nested-height|-W|-H|-r) shift 2 ;;
        *) args+=("\$1"); shift ;;
    esac
done
exec /usr/bin/gamescope -W $W -H $H -w $W -h $H -r $R -f "\${args[@]}"
EOF
    chmod 755 "$bin/gamescope"

    # gamescope-session execs gamescope, so this pid is gamescope's.
    PATH="$bin:$PATH" /usr/lib/steamos/gamescope-session >>"$log" 2>&1 </dev/null &
    gs=$!
    echo "$gs" > "$state/gamescope.pid"
    for _ in $(seq 150); do
        [[ -s "$envfile" ]] && break
        kill -0 "$gs" 2>/dev/null || { wait "$gs"; return; }
        sleep 0.2
    done
    if [[ ! -s "$envfile" ]]; then
        note "gamescope didn't report ready; stopping it"
        kill "$gs" 2>/dev/null; wait "$gs"; return
    fi
    # The units' EnvironmentFile. Children talk to gamescope, not to sway.
    mapfile -t envs < <(grep -v '^WAYLAND_DISPLAY=' "$envfile")
    svc() { env -i "${envs[@]}" "$@" >>"$log" 2>&1 </dev/null; }

    ( while kill -0 "$gs" 2>/dev/null; do svc mangoapp; sleep 1; done ) & pids+=($!)
    if command -v ibus-daemon >/dev/null; then
        svc ibus-daemon -r --panel=disable --emoji-extension=disable & pids+=($!)
        # Steam's runtime reaches IBus through its portal, which the session
        # bus starts with sway's display variables and so looks for another
        # IBus socket. Give the bus this IBus's address instead.
        local addr=""
        for _ in $(seq 25); do
            addr=$(env -i "${envs[@]}" ibus address 2>/dev/null)
            [[ -n "$addr" && "$addr" != "(null)" ]] && break
            addr=""; sleep 0.2
        done
        [[ -n "$addr" ]] && svc dbus-update-activation-environment "IBUS_ADDRESS=$addr"
    fi
    command -v steam_notif_daemon >/dev/null && { svc steam_notif_daemon & pids+=($!); }
    (
        while kill -0 "$gs" 2>/dev/null && [[ ! -e "$state/ending" ]]; do
            svc /usr/lib/steamos/steam-short-session-tracker --track-started
            if [[ -n "${STEAM_ARGS:-}" ]]; then
                # shellcheck disable=SC2086
                svc steam $STEAM_ARGS
            else
                svc /usr/lib/steamos/steam-launcher
            fi
            svc /usr/lib/steamos/steam-short-session-tracker --track-stopped
            [[ -e "$state/ending" ]] && break
            note "Steam exited; starting it again"
            sleep 1
        done
    ) & pids+=($!)

    wait "$gs"
    # gamescope is gone: the rest of the session goes with it.
    touch "$state/ending"
    pkill -u deck -x mangoapp 2>/dev/null
    pkill -u deck -x steam_notif_dae 2>/dev/null
    pkill -u deck -x ibus-daemon 2>/dev/null
    kill "${pids[@]}" 2>/dev/null
    wait "${pids[@]}" 2>/dev/null
    rm -f "$envfile" "$state/gamescope.pid"
}

# Desktop Mode: SteamOS's Plasma (steamdeck-kde-presets supplies the look,
# Steam's autostart and the Return to Gaming Mode icon, which logs out, and
# logging out brings Gaming Mode back). Nested in sway the way Valve's own
# holo-nested-desktop nests it: its own runtime dir sharing only the audio
# sockets, and kwin fullscreen without a lock screen.
run_plasma() {
    local rt=/run/user/1000 prt icons=/home/deck/.local/share/icons/hicolor/scalable/actions
    # A new user on SteamOS gets these from /etc/skel; this home predates it.
    if [[ -r /etc/skel/Desktop/Return.desktop && ! -e /home/deck/Desktop/Return.desktop ]]; then
        mkdir -p /home/deck/Desktop
        install -m755 /etc/skel/Desktop/Return.desktop /home/deck/Desktop/Return.desktop
    fi
    if [[ -e /usr/share/icons/hicolor/scalable/actions/steamdeck-gaming-return.svg ]]; then
        mkdir -p "$icons"
        ln -sf /usr/share/icons/hicolor/scalable/actions/steamdeck-gaming-return.svg "$icons/gaming-return.svg"
    fi

    # Plasma lays out the desktop from the global theme once, on the first
    # start. Homes whose first start predates the Steam Deck theme default
    # got plain Vapor's (KDE's wallpaper and launcher icon): let Plasma lay
    # it out again, once, unless a global theme was chosen since.
    local cfg=/home/deck/.config marker=/home/deck/.config/steamos-docker/deck-theme
    if [[ ! -e "$marker" ]]; then
        if [[ -e "$cfg/plasma-org.kde.plasma.desktop-appletsrc" ]] \
            && ! grep -qs '^LookAndFeelPackage=' "$cfg/kdeglobals"; then
            mv "$cfg/plasma-org.kde.plasma.desktop-appletsrc" "$cfg/plasma-org.kde.plasma.desktop-appletsrc.before-deck-theme"
            note "desktop layout set aside for the Steam Deck theme (kept as ~/.config/plasma-org.kde.plasma.desktop-appletsrc.before-deck-theme)"
        fi
        mkdir -p "$(dirname "$marker")" && touch "$marker"
    fi

    prt=$(mktemp -d "$rt/plasma.XXXXXXXX")
    mkdir -m700 "$prt/pulse" "$prt/bin"
    ln -s "$rt/pulse/native" "$prt/pulse/native"
    ln -s "$rt"/pipewire* "$prt/"
    printf '#!/bin/sh\nexec /usr/bin/kwin_wayland_wrapper --fullscreen true --no-lockscreen "$@"\n' \
        > "$prt/bin/kwin_wayland_wrapper"
    chmod 755 "$prt/bin/kwin_wayland_wrapper"

    # The session bus address lets end_session log out cleanly.
    env -u LD_PRELOAD PATH="$prt/bin:$PATH" XDG_RUNTIME_DIR="$prt" \
        WAYLAND_DISPLAY="$rt/$WAYLAND_DISPLAY" XDG_SESSION_TYPE=wayland \
        dbus-run-session -- sh -c 'echo "$DBUS_SESSION_BUS_ADDRESS" > "$1"; exec startplasma-wayland' \
        sh "$state/plasma-bus" >>"$log" 2>&1 </dev/null
    rm -f "$state/plasma-bus"
    rm -rf --one-file-system "$prt"
}

# Ends the running session so the loop moves on. steamos-session-control asks
# for this with SIGUSR1 instead of doing it itself: it's often called from
# inside Steam, and gamescope's reaper would kill it along with Steam.
end_session() {
    case "$(cat "$state/current" 2>/dev/null)" in
        plasma)
            if [[ -r "$state/plasma-bus" ]]; then
                DBUS_SESSION_BUS_ADDRESS=$(cat "$state/plasma-bus") \
                    timeout 10 dbus-send --session --type=method_call --dest=org.kde.Shutdown \
                    /Shutdown org.kde.Shutdown.logout 2>/dev/null || true
                for _ in $(seq 20); do [[ -e "$state/plasma-bus" ]] || return 0; sleep 1; done
            fi
            # (-f: the process name is cut to 15 characters, "startplasma-way")
            pkill -u deck -f '(^|/)startplasma-wayland' 2>/dev/null
            pkill -u deck -x kwin_wayland 2>/dev/null
            ;;
        *)
            # Stop Steam being started again, then let it exit cleanly first
            # so settings and cloud saves stick.
            touch "$state/ending"
            if pgrep -u deck -x steam >/dev/null; then
                timeout 30 steam -shutdown >/dev/null 2>&1 || true
                for _ in $(seq 30); do pgrep -u deck -x steam >/dev/null || break; sleep 1; done
            fi
            # Steam isn't gamescope's child here, so gamescope stays up after
            # it; stop it by pid (it renames itself "gamescope-wl").
            local gs
            gs=$(cat "$state/gamescope.pid" 2>/dev/null)
            [[ -n "$gs" ]] && kill "$gs" 2>/dev/null
            ;;
    esac
    return 0
}

echo $$ > "$state/manager.pid"
requested=0
trap 'requested=1; end_session &' USR1
trap 'note "stopping"; end_session; rm -f "$state/current" "$state/manager.pid"; exit 0' TERM INT

quick=0
while true; do
    # Steam's "Shut Down": stay off until the next Moonlight connection.
    while [[ -e "$state/off" ]]; do sleep 1; done

    session=$(next_session)
    echo "$session" > "$state/current"
    # sway's output is the picture Sunshine streams; size it like the session.
    IFS='x@' read -r W H R <<<"$(current_mode)"
    swaymsg -q -- output HEADLESS-1 mode --custom "${W}x${H}@${R}Hz" 2>/dev/null || true
    note "starting $session"
    started=$SECONDS
    case "$session" in
        plasma) run_plasma & ;;
        *)      run_gamescope & ;;
    esac
    # wait returns early whenever a signal arrives; keep waiting for the session.
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do wait "$pid"; done
    note "$session ended after $((SECONDS - started))s"

    # Don't spin if a session dies right away on its own (e.g. a broken
    # driver); switches asked for through steamos-session-control don't count.
    if (( requested )); then
        quick=0
    elif (( SECONDS - started < 15 )); then
        quick=$((quick + 1))
        (( quick >= 3 )) && { note "session keeps failing; waiting 30s"; sleep 30; }
    else
        quick=0
    fi
    requested=0
    sleep 1
done
