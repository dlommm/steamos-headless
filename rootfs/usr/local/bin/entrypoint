#!/bin/bash
# Container init: runs as root, prepares devices, then starts the session
# stack as `deck`. If any core service dies the container exits so the
# restart policy can bring it back cleanly.
set -euo pipefail

log() { echo "[steamos] $*"; }
as_deck() { sudo -u deck -E -H "$@"; }

# --- Resources -------------------------------------------------------------
# Nothing in this image limits CPU or RAM; report what the container actually
# got so a cap set elsewhere (compose, Docker daemon, LXC, NAS UI) is obvious.
cpus=$(nproc)
mem_gib=$(awk '/^MemTotal/ {printf "%.0f", $2/1048576}' /proc/meminfo)
log "resources: ${cpus} CPU threads, ${mem_gib} GiB RAM visible"
cg_cpu=$(cat /sys/fs/cgroup/cpu.max 2>/dev/null || echo max)
cg_mem=$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo max)
if [[ "${cg_cpu%% *}" != "max" ]]; then
    log "WARNING: CPU is capped by cgroup (cpu.max=${cg_cpu}); remove cpus/cpu limits to use every core"
fi
if [[ "$cg_mem" != "max" ]]; then
    log "WARNING: RAM is capped by cgroup at $((cg_mem / 1073741824)) GiB; remove mem_limit to use all memory"
fi

# --- GPU -------------------------------------------------------------------
# One image serves both vendors. GPU_VENDOR=auto picks NVIDIA when the host
# has the NVIDIA driver loaded, otherwise AMD; set nvidia/amd to override on
# multi-GPU hosts. RENDER_NODE (e.g. /dev/dri/renderD129) overrides the device.

# Prints the first render node whose kernel driver is $1.
render_node_for() {
    local node
    for node in /sys/class/drm/renderD*; do
        [[ -e "$node/device/driver" ]] || continue
        # Skip nodes hidden by NVIDIA_GPU (removed from this container's /dev).
        [[ -e "/dev/dri/$(basename "$node")" ]] || continue
        if [[ "$(basename "$(readlink -f "$node/device/driver")")" == "$1" ]]; then
            echo "/dev/dri/$(basename "$node")"
            return 0
        fi
    done
    return 1
}

GPU_VENDOR=${GPU_VENDOR:-auto}
if [[ "$GPU_VENDOR" == "auto" ]]; then
    if [[ -r /proc/driver/nvidia/version ]]; then
        GPU_VENDOR=nvidia
    elif render_node_for amdgpu >/dev/null; then
        GPU_VENDOR=amd
    else
        GPU_VENDOR=none
    fi
fi

# NVIDIA_GPU picks one card on multi-GPU hosts (index in nvidia-smi order, or
# PCI address like 0000:41:00.0), e.g. to leave the other one to AI containers.
# The other cards' device nodes are removed from this container's own /dev
# (the host is unaffected), the same isolation NVIDIA_VISIBLE_DEVICES gives.
select_nvidia_gpu() {
    local want=$1 i=0 gpu pci minor node keep="" name=""
    for gpu in $(ls -d /proc/driver/nvidia/gpus/* 2>/dev/null | sort); do
        pci=$(basename "$gpu")
        if [[ "$want" == "$i" || "${pci,,}" == "${want,,}" || "${pci,,}" == "0000:${want,,}" ]]; then
            keep=$pci
            name=$(awk -F':[ \t]*' '/^Model/ {print $2}' "$gpu/information")
        fi
        i=$((i + 1))
    done
    [[ -n "$keep" ]] || { log "ERROR: NVIDIA_GPU=$want matches no GPU (have $i)"; exit 1; }
    for gpu in /proc/driver/nvidia/gpus/*; do
        pci=$(basename "$gpu")
        [[ "$pci" == "$keep" ]] && continue
        minor=$(awk -F':[ \t]*' '/^Device Minor/ {print $2}' "$gpu/information")
        rm -f "/dev/nvidia${minor}"
        for node in /sys/bus/pci/devices/"$pci"/drm/card* /sys/bus/pci/devices/"$pci"/drm/renderD*; do
            [[ -e "$node" ]] && rm -f "/dev/dri/$(basename "$node")"
        done
    done
    log "NVIDIA_GPU=$want: using ${name:-GPU} at $keep only"
}

case "$GPU_VENDOR" in
    nvidia)
        if [[ -n "${NVIDIA_GPU:-}" ]]; then
            select_nvidia_gpu "$NVIDIA_GPU"
        fi
        /usr/local/bin/nvidia-userspace-install
        RENDER_NODE=${RENDER_NODE:-$(render_node_for nvidia || true)}
        [[ -n "$RENDER_NODE" ]] || log "ERROR: NVIDIA driver loaded but no render node; enable nvidia-drm.modeset=1 on the host"
        export GBM_BACKEND=nvidia-drm __GLX_VENDOR_LIBRARY_NAME=nvidia \
               WLR_RENDERER=vulkan WLR_NO_HARDWARE_CURSORS=1
        SUNSHINE_ENCODER=nvenc
        ;;
    amd)
        RENDER_NODE=${RENDER_NODE:-$(render_node_for amdgpu || true)}
        export LIBVA_DRIVER_NAME=radeonsi
        SUNSHINE_ENCODER=vaapi
        ;;
    none) ;;
    *)
        log "ERROR: GPU_VENDOR must be auto, nvidia or amd (got '$GPU_VENDOR')"
        exit 1
        ;;
esac

if [[ -z "${RENDER_NODE:-}" || ! -e "${RENDER_NODE}" ]]; then
    log "ERROR: no usable AMD or NVIDIA GPU found in /dev/dri. Is the GPU passed through?"
    [[ "${ALLOW_NO_GPU:-0}" == "1" ]] || exit 1
    log "ALLOW_NO_GPU=1: continuing with software rendering and encoding"
    export WLR_RENDERER=pixman
    RENDER_NODE=""
    SUNSHINE_ENCODER=software
fi
export GPU_VENDOR RENDER_NODE SUNSHINE_ENCODER
log "GPU: ${GPU_VENDOR} render node: ${RENDER_NODE:-none} encoder: ${SUNSHINE_ENCODER}"

# Let deck use whatever groups own the passed-through device nodes.
for dev in /dev/dri/* /dev/uinput /dev/input/event* /dev/nvidia*; do
    [[ -e "$dev" ]] || continue
    gid=$(stat -c %g "$dev")
    [[ "$gid" == 0 ]] && continue
    getent group "$gid" >/dev/null || groupadd -g "$gid" "hostgrp$gid"
    usermod -aG "$(getent group "$gid" | cut -d: -f1)" deck
done
if [[ -e /dev/uinput && ! -w /dev/uinput ]] || ! sudo -u deck test -w /dev/uinput 2>/dev/null; then
    log "WARNING: deck cannot write /dev/uinput; Moonlight input will not work."
    log "         Install host/60-steamos-docker.rules on the host (see README)."
fi

# --- System services -------------------------------------------------------
mkdir -p /run/dbus
rm -f /run/dbus/pid
dbus-daemon --system --fork

# mDNS so Moonlight finds the host automatically. Sunshine publishes through
# Avahi on the container's own D-Bus, so Avahi runs here even if the host has
# one too (both answering on the host network is fine). AVAHI=0 disables it.
if [[ "${AVAHI:-1}" == "1" ]]; then
    mkdir -p /run/avahi-daemon
    # Only the LAN interface: on the host network Avahi would also join Docker
    # bridges/veths, hear its own announcements and loop on name conflicts.
    mdns_if=${MDNS_INTERFACE:-$(ip route show default | awk '{print $5; exit}')}
    # Unraid routes through a macvlan helper (shim-br0) when "host access to
    # custom networks" is on; the real LAN bridge is the part after "shim-".
    if [[ "$mdns_if" == shim-* && -d "/sys/class/net/${mdns_if#shim-}" ]]; then
        mdns_if=${mdns_if#shim-}
    fi
    # With host networking the container shares the host's IPs and hostname.
    # If the host already runs an mDNS responder (UDP 5353 is bound), let it
    # own the hostname/address records and only publish Sunshine's service;
    # publishing them twice makes both responders loop on name conflicts.
    publish_addresses=yes
    if awk 'NR>1 && $2 ~ /:14E9$/ {found=1} END {exit !found}' /proc/net/udp /proc/net/udp6 2>/dev/null; then
        publish_addresses=no
    fi
    sed -e "s/^\[server\]/[server]\nallow-interfaces=${mdns_if}/" \
        -e "s/^publish-addresses=.*/publish-addresses=${publish_addresses}/" \
        /etc/steamos-docker/avahi-daemon.conf > /run/avahi-daemon/avahi-daemon.conf
    log "mDNS on ${mdns_if:-all interfaces} as $(cat /proc/sys/kernel/hostname).local (host responder present: $([[ $publish_addresses == no ]] && echo yes || echo no))"
    avahi-daemon -f /run/avahi-daemon/avahi-daemon.conf --no-drop-root --no-chroot --no-rlimits \
        >/var/log/avahi.log 2>&1 &
    sleep 1
    kill -0 $! 2>/dev/null \
        || log "WARNING: avahi-daemon failed (see /var/log/avahi.log); add the host manually in Moonlight"
fi

# seatd hands sway access to input devices without a real VT/logind.
SEATD_VTBOUND=0 seatd -g video -l error &
SEATD_PID=$!
export LIBSEAT_BACKEND=seatd

chown deck:deck /run/user/1000 /home/deck
chmod 700 /run/user/1000
as_deck mkdir -p /home/deck/.local/state /home/deck/.config

# --- User session ----------------------------------------------------------
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
as_deck dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --fork --nopidfile

as_deck pipewire &
PIPEWIRE_PID=$!
sleep 1
as_deck wireplumber &
as_deck pipewire-pulse &

# sway provides a headless output that Sunshine captures (wlr-screencopy),
# and reads Sunshine's virtual input devices through libinput.
export WLR_BACKENDS=headless,libinput \
       WLR_HEADLESS_OUTPUTS=1 \
       WLR_LIBINPUT_NO_DEVICES=1 \
       WLR_RENDER_DRM_DEVICE="${RENDER_NODE}"
[[ -z "${RENDER_NODE}" ]] && unset WLR_RENDER_DRM_DEVICE
as_deck sway --unsupported-gpu -c /etc/steamos-docker/sway.conf &
SWAY_PID=$!

for _ in $(seq 50); do
    [[ -S /run/user/1000/wayland-1 ]] && break
    sleep 0.2
done
[[ -S /run/user/1000/wayland-1 ]] || { log "ERROR: sway did not start"; exit 1; }
export WAYLAND_DISPLAY=wayland-1
log "sway is up on ${WAYLAND_DISPLAY}"

# Extra Steam libraries (e.g. an HDD at /games). Only the top-level folder is
# handed to deck; existing game files are never chowned recursively.
IFS=: read -r -a steam_libs <<<"${STEAM_LIBRARIES:-/games}"
for lib in "${steam_libs[@]}"; do
    [[ -n "$lib" && -d "$lib" ]] || continue
    sudo -u deck test -w "$lib" || chown deck:deck "$lib"
    log "Steam library: $lib ($(df -h --output=avail "$lib" | tail -1 | tr -d ' ') free)"
done
as_deck /usr/local/bin/steam-libraries || log "WARNING: could not register Steam libraries"

# Steam starts right away (like a console) so it can update and log in before
# anyone connects; Sunshine re-launches it at the client's resolution.
IFS=x read -r W H <<<"${STEAMOS_RESOLUTION}"
SUNSHINE_CLIENT_WIDTH=$W SUNSHINE_CLIENT_HEIGHT=$H SUNSHINE_CLIENT_FPS=$STEAMOS_REFRESH \
    as_deck /usr/local/bin/steamos-session || log "WARNING: initial Steam launch failed; see ~/.local/state/steamos-session.log"

as_deck /usr/local/bin/sunshine-setup
# The encoder follows whatever GPU was detected this boot, unless one was
# picked explicitly in the web UI (saved to sunshine.conf).
sunshine_conf=/home/deck/.config/sunshine/sunshine.conf
sunshine_args=()
# Sunshine's CSRF check only trusts localhost by default, which blocks the web
# UI when opened as https://<server-ip>:47990. Trust this host's own LAN
# addresses and hostname (recomputed each start in case the IP changes).
if ! grep -qE '^\s*csrf_allowed_origins\s*=' "$sunshine_conf"; then
    host=$(cat /proc/sys/kernel/hostname)
    origins=("https://${host}" "https://${host}.local")
    while read -r ifname addr; do
        [[ "$ifname" =~ ^(docker|br-|veth|virbr) ]] && continue
        origins+=("https://${addr%/*}")
    done < <(ip -o addr show scope global | awk '{print $2, $4}')
    [[ -n "${SUNSHINE_ALLOWED_ORIGINS:-}" ]] && origins+=("$SUNSHINE_ALLOWED_ORIGINS")
    csrf=""
    for o in "${origins[@]}"; do
        [[ "$o" == *:*:* ]] && o="https://[${o#https://}]"   # IPv6 needs brackets
        csrf+="${csrf:+,}${o},${o}:47990"
    done
    sunshine_args+=("csrf_allowed_origins=${csrf}")
fi
if ! grep -qE '^\s*encoder\s*=' "$sunshine_conf"; then
    sunshine_args+=("encoder=${SUNSHINE_ENCODER}")
    if [[ "$SUNSHINE_ENCODER" == "vaapi" ]]; then
        sunshine_args+=("adapter_name=${RENDER_NODE}")
    fi
fi
as_deck sunshine "$sunshine_conf" "${sunshine_args[@]}" &
SUNSHINE_PID=$!
log "Sunshine web UI: https://<host-ip>:47990"

trap 'log "stopping"; kill -TERM $SUNSHINE_PID $SWAY_PID $PIPEWIRE_PID $SEATD_PID 2>/dev/null; exit 0' TERM INT
wait -n $SUNSHINE_PID $SWAY_PID $PIPEWIRE_PID $SEATD_PID
log "a core service exited; stopping container"
exit 1
