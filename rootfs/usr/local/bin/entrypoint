#!/bin/bash
# Container init: runs as root, prepares devices, then starts the session
# stack as `deck`. If any core service dies the container exits so the
# restart policy can bring it back cleanly.
set -euo pipefail

log() { echo "[steamos] $*"; }
as_deck() { sudo -u deck -E -H "$@"; }

# --- Version / network -----------------------------------------------------
. /etc/steamos-docker-release 2>/dev/null || true
log "image ${IMAGE_VERSION:-unknown} (SteamOS ${STEAMOS_VERSION:-?}, Sunshine ${SUNSHINE_VERSION:-?})"
# Works: host networking, or a macvlan/ipvlan network that gives the container
# its own LAN IP (Unraid "Custom: br0"). Doesn't: Docker's default bridge (a
# veth behind NAT), where Moonlight discovery and Sunshine's ports can't reach it.
if [[ ! -e /sys/class/net/docker0 ]] && ip -d link show 2>/dev/null | grep -q ' veth '; then
    log "WARNING: on Docker's internal bridge network; Moonlight can't discover or reach Sunshine."
    log "         Use host networking (network_mode: host / Unraid Network Type: Host) or a"
    log "         macvlan/ipvlan network with its own LAN IP (Unraid Custom: br0)."
fi

# --- Resources -------------------------------------------------------------
# Nothing in this image limits CPU or RAM; report what the container actually
# got so a cap set elsewhere (compose, Docker daemon, LXC, NAS UI) is obvious.
cpus=$(nproc)
mem_gib=$(awk '/^MemTotal/ {printf "%.0f", $2/1048576}' /proc/meminfo)
log "resources: ${cpus} CPU threads, ${mem_gib} GiB RAM visible"
cg_cpu=$(cat /sys/fs/cgroup/cpu.max 2>/dev/null || echo max)
cg_mem=$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo max)
if [[ "${cg_cpu%% *}" != "max" ]]; then
    log "WARNING: CPU is capped by cgroup (cpu.max=${cg_cpu}); remove cpus/cpu limits to use every core"
fi
if [[ "$cg_mem" != "max" ]]; then
    log "WARNING: RAM is capped by cgroup at $((cg_mem / 1073741824)) GiB; remove mem_limit to use all memory"
fi

# --- GPU -------------------------------------------------------------------
# One image serves AMD and NVIDIA. Every GPU is listed at start and exactly one
# is used; all others are hidden from this container. That keeps sway,
# gamescope and Sunshine on the same card (NVIDIA refuses buffers shared across
# cards) and lets several containers each own a GPU (one per person).
#   GPU=<PCI address>    choose a card, e.g. 0000:c1:00.0 or c1:00.0
#   otherwise            dedicated NVIDIA > dedicated AMD > integrated AMD
#                        (GPU_VENDOR=nvidia|amd limits the automatic choice)
#   GPU_ISOLATE=0        don't hide the other cards

pci_of()    { basename "$(readlink -f "/sys/class/drm/$1/device")"; }
driver_of() { basename "$(readlink -f "/sys/class/drm/$1/device/driver" 2>/dev/null)"; }
norm_pci()  { local p=${1,,}; [[ "$p" == *:*:* ]] || p="0000:$p"; echo "$p"; }

declare -A gpu_driver gpu_kind gpu_render gpu_name
gpu_pcis=()
for card in /sys/class/drm/card[0-9]*; do
    name=$(basename "$card")
    [[ "$name" == *-* || ! -e "$card/device/driver" ]] && continue   # skip connectors
    pci=$(pci_of "$name")
    [[ -n "${gpu_driver[$pci]:-}" ]] && continue
    drv=$(driver_of "$name")
    render=$(ls -d /sys/bus/pci/devices/"$pci"/drm/renderD* 2>/dev/null | head -1 || true)
    case "$drv" in
        nvidia) kind=dedicated ;;
        amdgpu)
            vram=$(cat "/sys/bus/pci/devices/$pci/mem_info_vram_total" 2>/dev/null || echo 0)
            if (( vram >= 4 * 1024 * 1024 * 1024 )); then kind=dedicated; else kind=integrated; fi ;;
        *) kind=unsupported ;;   # Intel, BMC/server VGA (ast, mgag200), simpledrm...
    esac
    gpu_pcis+=("$pci")
    gpu_driver[$pci]=$drv
    gpu_kind[$pci]=$kind
    gpu_render[$pci]=${render:+/dev/dri/$(basename "$render")}
    gpu_name[$pci]=$(lspci -s "$pci" -mm 2>/dev/null | awk -F'"' '{print $6}' || true)
done
mapfile -t gpu_pcis < <(printf '%s\n' "${gpu_pcis[@]}" | sed '/^$/d' | sort)

USER_WLR_RENDERER=${WLR_RENDERER:-}
GPU_VENDOR=${GPU_VENDOR:-auto}
selected=""
if [[ -n "${RENDER_NODE:-}" ]]; then
    selected=$(pci_of "$(basename "$RENDER_NODE")")
elif [[ -n "${GPU:-}" ]]; then
    selected=$(norm_pci "$GPU")
elif [[ -n "${NVIDIA_GPU:-}" ]]; then   # older setting: nvidia-smi index or PCI
    if [[ "$NVIDIA_GPU" =~ ^[0-9]+$ ]]; then
        selected=$(ls -d /proc/driver/nvidia/gpus/* 2>/dev/null | sort | sed -n "$((NVIDIA_GPU + 1))p" | xargs -r basename)
    else
        selected=$(norm_pci "$NVIDIA_GPU")
    fi
else
    for want in "nvidia dedicated" "amdgpu dedicated" "amdgpu integrated"; do
        read -r d k <<<"$want"
        [[ "$GPU_VENDOR" == amd && "$d" == nvidia ]] && continue
        [[ "$GPU_VENDOR" == nvidia && "$d" == amdgpu ]] && continue
        for pci in "${gpu_pcis[@]}"; do
            if [[ "${gpu_driver[$pci]}" == "$d" && "${gpu_kind[$pci]}" == "$k" && -n "${gpu_render[$pci]}" ]]; then
                selected=$pci
                break 2
            fi
        done
    done
fi

log "GPUs found:"
[[ ${#gpu_pcis[@]} -gt 0 ]] || log "  (none)"
for pci in "${gpu_pcis[@]}"; do
    mark=""
    [[ "$pci" == "$selected" ]] && mark="  <- using"
    log "$(printf '  %-13s %-8s %-12s %-20s %s%s' "$pci" "${gpu_driver[$pci]}" "${gpu_kind[$pci]}" \
        "${gpu_render[$pci]:-(no render)}" "${gpu_name[$pci]:-?}" "$mark")"
done

if [[ -n "$selected" && -z "${gpu_driver[$selected]:-}" ]]; then
    log "ERROR: GPU=${GPU:-${NVIDIA_GPU:-$RENDER_NODE}} doesn't match any GPU above"
    exit 1
fi

selected_driver=""
if [[ -n "$selected" ]]; then
    selected_driver=${gpu_driver[$selected]:-}
fi
case "$selected_driver" in
    nvidia)
        GPU_VENDOR=nvidia
        /usr/local/bin/nvidia-userspace-install
        RENDER_NODE=${RENDER_NODE:-${gpu_render[$selected]}}
        [[ -n "$RENDER_NODE" ]] || log "ERROR: NVIDIA GPU has no render node; enable nvidia-drm.modeset=1 on the host"
        export GBM_BACKEND=nvidia-drm __GLX_VENDOR_LIBRARY_NAME=nvidia WLR_NO_HARDWARE_CURSORS=1
        SUNSHINE_ENCODER=nvenc
        ;;
    amdgpu)
        GPU_VENDOR=amd
        RENDER_NODE=${RENDER_NODE:-${gpu_render[$selected]}}
        export LIBVA_DRIVER_NAME=radeonsi
        SUNSHINE_ENCODER=vaapi
        ;;
    "")
        GPU_VENDOR=none
        RENDER_NODE=""
        ;;
    *)
        log "ERROR: the GPU at $selected ($selected_driver) isn't supported; this image supports AMD and NVIDIA"
        exit 1
        ;;
esac

if [[ -z "${RENDER_NODE:-}" || ! -e "${RENDER_NODE}" ]]; then
    log "ERROR: no usable AMD or NVIDIA GPU found in /dev/dri. Is the GPU passed through?"
    [[ "${ALLOW_NO_GPU:-0}" == "1" ]] || exit 1
    log "ALLOW_NO_GPU=1: continuing with software rendering and encoding"
    RENDER_NODE=""
    selected=""
    SUNSHINE_ENCODER=software
fi
export GPU_VENDOR RENDER_NODE SUNSHINE_ENCODER

# Hide every other GPU: its /dev/dri nodes and, for NVIDIA, its /dev/nvidiaN
# (this container's own /dev; the host and other containers are unaffected).
if [[ -n "$selected" && "${GPU_ISOLATE:-1}" == "1" ]]; then
    hidden=()
    for n in /dev/dri/card* /dev/dri/renderD*; do
        [[ -e "$n" ]] || continue
        if [[ "$(pci_of "$(basename "$n")")" != "$selected" ]]; then
            rm -f "$n"
            hidden+=("$(basename "$n")")
        fi
    done
    for gpu in /proc/driver/nvidia/gpus/*; do
        [[ -e "$gpu/information" && "$(basename "$gpu")" != "$selected" ]] || continue
        minor=$(awk -F':[ \t]*' '/^Device Minor/ {print $2}' "$gpu/information")
        if [[ -e "/dev/nvidia$minor" ]]; then
            rm -f "/dev/nvidia$minor"
            hidden+=("nvidia$minor")
        fi
    done
    if [[ ${#hidden[@]} -gt 0 ]]; then
        log "other GPUs hidden in this container: ${hidden[*]}"
    fi
fi
log "GPU: ${GPU_VENDOR} ${selected:+at $selected }render node: ${RENDER_NODE:-none} encoder: ${SUNSHINE_ENCODER}"

# Let deck use whatever groups own the passed-through device nodes.
for dev in /dev/dri/* /dev/uinput /dev/input/event* /dev/nvidia*; do
    [[ -e "$dev" ]] || continue
    gid=$(stat -c %g "$dev")
    [[ "$gid" == 0 ]] && continue
    getent group "$gid" >/dev/null || groupadd -g "$gid" "hostgrp$gid"
    usermod -aG "$(getent group "$gid" | cut -d: -f1)" deck
done
# uinput/uhid (Sunshine's virtual keyboard, mouse and controllers) are root-only
# unless the host has a udev rule. In a privileged container they're the
# container's own device nodes, so open them to the input group here.
for dev in /dev/uinput /dev/uhid; do
    [[ -c "$dev" ]] && ! sudo -u deck test -w "$dev" || continue
    chgrp input "$dev" 2>/dev/null && chmod 0660 "$dev" 2>/dev/null && usermod -aG input deck
done
if [[ -e /dev/uinput && ! -w /dev/uinput ]] || ! sudo -u deck test -w /dev/uinput 2>/dev/null; then
    log "WARNING: deck cannot write /dev/uinput; Moonlight input will not work."
    log "         Install host/60-steamos-docker.rules on the host (see README), or run privileged."
fi

# --- System services -------------------------------------------------------
mkdir -p /run/dbus
rm -f /run/dbus/pid
dbus-daemon --system --fork

# NetworkManager, only to report the connection to Steam (see
# /usr/lib/NetworkManager/conf.d/90-steamos-docker.conf); it changes nothing.
# It sees just the default-route interface, which matters under host
# networking where every host interface is visible. With a writable /sys
# (privileged) it would wait for udev to initialize the link, which never
# happens here, so it gets a private read-only view of /sys. NETWORKMANAGER=0
# disables it.
if [[ "${NETWORKMANAGER:-1}" == "1" ]]; then
    nm_if=$(ip route show default | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
    nm_devs="except:interface-name:${nm_if:-eth0}"
    # A macvlan/ipvlan link (Unraid Custom: br0) has its parent outside the
    # container, so NetworkManager can't describe it and reports it as
    # disconnected. Give it an internal veth pair (no routes, carries nothing)
    # to show as the wired connection; the connectivity check still runs over
    # the real interface, so Steam sees "connected" with full internet.
    if ip -d link show dev "${nm_if:-eth0}" 2>/dev/null | grep -qwE 'ipvlan|macvlan'; then
        ip link add wired type veth peer name wired-peer 2>/dev/null || true
        ip addr replace 169.254.77.1/30 dev wired
        ip link set wired up && ip link set wired-peer up
        nm_devs+=";except:interface-name:wired"
    fi
    mkdir -p /run/NetworkManager/conf.d
    printf '[keyfile]\nunmanaged-devices=%s\n' "$nm_devs" > /run/NetworkManager/conf.d/90-interface.conf
    unshare -m --propagation private \
        sh -c 'mount -o remount,bind,ro /sys && exec NetworkManager --no-daemon' &
fi

# mDNS so Moonlight finds the host automatically. Sunshine publishes through
# Avahi on the container's own D-Bus, so Avahi runs here even if the host has
# one too (both answering on the host network is fine). AVAHI=0 disables it.
if [[ "${AVAHI:-1}" == "1" ]]; then
    mkdir -p /run/avahi-daemon
    # Only the LAN interface: on the host network Avahi would also join Docker
    # bridges/veths, hear its own announcements and loop on name conflicts.
    mdns_if=${MDNS_INTERFACE:-$(ip route show default | awk '{print $5; exit}')}
    # Unraid routes through a macvlan helper (shim-br0) when "host access to
    # custom networks" is on; the real LAN bridge is the part after "shim-".
    if [[ "$mdns_if" == shim-* && -d "/sys/class/net/${mdns_if#shim-}" ]]; then
        mdns_if=${mdns_if#shim-}
    fi
    # With host networking the container shares the host's IPs and hostname.
    # If the host already runs an mDNS responder (UDP 5353 is bound), let it
    # own the hostname/address records and only publish Sunshine's service;
    # publishing them twice makes both responders loop on name conflicts.
    publish_addresses=yes
    if awk 'NR>1 && $2 ~ /:14E9$/ {found=1} END {exit !found}' /proc/net/udp /proc/net/udp6 2>/dev/null; then
        publish_addresses=no
    fi
    sed -e "s/^\[server\]/[server]\nallow-interfaces=${mdns_if}/" \
        -e "s/^publish-addresses=.*/publish-addresses=${publish_addresses}/" \
        /etc/steamos-docker/avahi-daemon.conf > /run/avahi-daemon/avahi-daemon.conf
    log "mDNS on ${mdns_if:-all interfaces} as $(cat /proc/sys/kernel/hostname).local (host responder present: $([[ $publish_addresses == no ]] && echo yes || echo no))"
    avahi-daemon -f /run/avahi-daemon/avahi-daemon.conf --no-drop-root --no-chroot --no-rlimits \
        >/var/log/avahi.log 2>&1 &
    sleep 1
    kill -0 $! 2>/dev/null \
        || log "WARNING: avahi-daemon failed (see /var/log/avahi.log); add the host manually in Moonlight"
fi

# seatd hands sway access to input devices without a real VT/logind.
SEATD_VTBOUND=0 seatd -g video -l error &
SEATD_PID=$!
export LIBSEAT_BACKEND=seatd
# Outside host networking, udevd's hotplug broadcasts don't reach this
# container, so sway and Steam would never see Sunshine's virtual input
# devices. The relay re-sends them here; under host networking it notices
# udevd's own broadcasts and exits.
/usr/local/bin/udev-relay &

chown deck:deck /run/user/1000 /home/deck
chmod 700 /run/user/1000
as_deck mkdir -p /home/deck/.local/state /home/deck/.config

# --- Optional SSH (debugging) ---------------------------------------------
# Off unless SSH_AUTHORIZED_KEYS is set. Key-only login as deck (who has sudo
# inside the container), on SSH_PORT (default 2222 so it never collides with
# the host's own sshd under host networking). Host keys persist in /home/deck
# so the fingerprint stays the same across updates.
if [[ -n "${SSH_AUTHORIZED_KEYS:-}" ]]; then
    ssh_dir=/home/deck/.config/steamos-docker/ssh
    as_deck mkdir -p /home/deck/.config/steamos-docker
    install -d -o deck -g deck -m 700 /home/deck/.ssh
    printf '%s\n' "$SSH_AUTHORIZED_KEYS" > /home/deck/.ssh/authorized_keys
    chown deck:deck /home/deck/.ssh/authorized_keys
    chmod 600 /home/deck/.ssh/authorized_keys
    mkdir -p "$ssh_dir"
    [[ -e "$ssh_dir/ssh_host_ed25519_key" ]] || ssh-keygen -q -t ed25519 -N "" -f "$ssh_dir/ssh_host_ed25519_key"
    usermod -p '*' deck   # unlocked for key auth, but no password works
    /usr/bin/sshd -p "${SSH_PORT:-2222}" -h "$ssh_dir/ssh_host_ed25519_key" \
        -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no \
        -o PermitRootLogin=no -o AllowUsers=deck -o PidFile=/run/sshd.pid \
        && log "SSH enabled: ssh -p ${SSH_PORT:-2222} deck@<container-ip> (key auth only)" \
        || log "WARNING: sshd failed to start"
fi


# --- User session ----------------------------------------------------------
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
as_deck dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --fork --nopidfile

as_deck pipewire &
PIPEWIRE_PID=$!
sleep 1
as_deck wireplumber &
as_deck pipewire-pulse &

# Extra Steam libraries (e.g. an HDD at /games). Only the top-level folder is
# handed to deck; existing game files are never chowned recursively.
IFS=: read -r -a steam_libs <<<"${STEAM_LIBRARIES:-/games}"
for lib in "${steam_libs[@]}"; do
    [[ -n "$lib" && -d "$lib" ]] || continue
    sudo -u deck test -w "$lib" || chown deck:deck "$lib"
    log "Steam library: $lib ($(df -h --output=avail "$lib" | tail -1 | tr -d ' ') free)"
done
as_deck /usr/local/bin/steam-libraries || log "WARNING: could not register Steam libraries"

as_deck /usr/local/bin/sunshine-setup
# The encoder follows whatever GPU was detected this boot, unless one was
# picked explicitly in the web UI (saved to sunshine.conf).
sunshine_conf=/home/deck/.config/sunshine/sunshine.conf
sunshine_args=()
# Sunshine's CSRF check only trusts localhost by default, which blocks the web
# UI when opened as https://<server-ip>:47990. Trust this host's own LAN
# addresses and hostname (recomputed each start in case the IP changes).
if ! grep -qE '^\s*csrf_allowed_origins\s*=' "$sunshine_conf"; then
    host=$(cat /proc/sys/kernel/hostname)
    origins=("https://${host}" "https://${host}.local")
    while read -r ifname addr; do
        [[ "$ifname" =~ ^(docker|br-|veth|virbr) ]] && continue
        origins+=("https://${addr%/*}")
    done < <(ip -o addr show scope global | awk '{print $2, $4}')
    [[ -n "${SUNSHINE_ALLOWED_ORIGINS:-}" ]] && origins+=("$SUNSHINE_ALLOWED_ORIGINS")
    csrf=""
    for o in "${origins[@]}"; do
        [[ "$o" == *:*:* ]] && o="https://[${o#https://}]"   # IPv6 needs brackets
        csrf+="${csrf:+,}${o},${o}:47990"
    done
    sunshine_args+=("csrf_allowed_origins=${csrf}")
fi
if ! grep -qE '^\s*encoder\s*=' "$sunshine_conf"; then
    sunshine_args+=("encoder=${SUNSHINE_ENCODER}")
fi
# Sunshine's Wayland capture (and VAAPI) open this render node. Unset, it looks
# for a card with a connected monitor and, headless, falls back to renderD128,
# which may be another GPU or hidden here: streams then stay black.
if [[ -n "$RENDER_NODE" ]] && ! grep -qE '^\s*adapter_name\s*=' "$sunshine_conf"; then
    sunshine_args+=("adapter_name=${RENDER_NODE}")
fi

# --- Display stack: sway -> Steam in gamescope -> Sunshine -----------------
# sway provides a headless output that Sunshine captures (wlr-screencopy),
# and reads Sunshine's virtual input devices through libinput.
export WLR_BACKENDS=headless,libinput WLR_HEADLESS_OUTPUTS=1 WLR_LIBINPUT_NO_DEVICES=1
if [[ -n "${RENDER_NODE}" ]]; then
    export WLR_RENDER_DRM_DEVICE="${RENDER_NODE}"
fi
mkdir -p /run/steamos

start_sway() {
    : > /run/steamos/sway.log
    rm -f /run/user/1000/wayland-1 /run/user/1000/wayland-1.lock
    as_deck sway --unsupported-gpu -c /etc/steamos-docker/sway.conf \
        > >(tee -a /run/steamos/sway.log) 2>&1 &
    SWAY_PID=$!
    for _ in $(seq 50); do
        [[ -S /run/user/1000/wayland-1 ]] && break
        kill -0 "$SWAY_PID" 2>/dev/null || return 1
        sleep 0.2
    done
    [[ -S /run/user/1000/wayland-1 ]] || return 1
    export WAYLAND_DISPLAY=wayland-1
}

# Steam starts right away (like a console) so it can update and log in before
# anyone connects; Sunshine re-launches it at the client's resolution.
start_steam() {
    IFS=x read -r W H <<<"${STEAMOS_RESOLUTION}"
    SUNSHINE_CLIENT_WIDTH=$W SUNSHINE_CLIENT_HEIGHT=$H SUNSHINE_CLIENT_FPS=$STEAMOS_REFRESH \
        as_deck /usr/local/bin/steamos-session \
        || log "WARNING: initial Steam launch failed; see ~/.local/state/steamos-session.log"
}

start_sunshine() {
    : > /run/steamos/sunshine.log
    as_deck sunshine "$sunshine_conf" "${sunshine_args[@]}" \
        > >(tee -a /run/steamos/sunshine.log) 2>&1 &
    SUNSHINE_PID=$!
}

stop_stack() {
    kill -TERM "$SUNSHINE_PID" 2>/dev/null || true
    # Only ask a running Steam to quit: "steam -shutdown" would start one.
    if pgrep -u deck -x steam >/dev/null; then
        timeout 20 sudo -u deck -E -H steam -shutdown >/dev/null 2>&1 || true
        for _ in $(seq 15); do pgrep -u deck -x steam >/dev/null || break; sleep 1; done
    fi
    pkill -u deck -x gamescope 2>/dev/null || true
    pkill -u deck -x steam 2>/dev/null || true
    kill -TERM "$SWAY_PID" 2>/dev/null || true
    for _ in $(seq 20); do
        kill -0 "$SUNSHINE_PID" 2>/dev/null || kill -0 "$SWAY_PID" 2>/dev/null || break
        sleep 0.5
    done
    kill -KILL "$SUNSHINE_PID" "$SWAY_PID" 2>/dev/null || true
    rm -f /run/user/1000/steamos-session.mode
}

# Sunshine test-encodes captured frames at startup. If sway can't import the
# capture buffer it logs "Failed to import DMA-BUF", and real streams then
# fail with "Couldn't import RGB Image". Use that as a self-test.
capture_selftest() {
    for _ in $(seq 60); do
        grep -q 'Configuration UI available' /run/steamos/sunshine.log && break
        kill -0 "$SUNSHINE_PID" 2>/dev/null || return 1
        sleep 0.5
    done
    sleep 1
    ! grep -q 'Failed to import DMA-BUF' /run/steamos/sway.log
}

# Renderer candidates, a WLR_RENDERER the user set is used as-is. Results are
# remembered per image + driver, so later starts go straight to what worked.
state_file=/home/deck/.config/steamos-docker/renderer
driver_id=$GPU_VENDOR
if [[ -r /proc/driver/nvidia/version ]]; then
    driver_id=nvidia-$(grep -oP 'Kernel Module(?: for x86_64)?\s+\K[0-9.]+' /proc/driver/nvidia/version | head -1)
fi
state_key="${IMAGE_VERSION:-dev}|${driver_id}"
good="" failed=""
if [[ -r "$state_file" ]] && [[ "$(sed -n 's/^key=//p' "$state_file")" == "$state_key" ]]; then
    good=$(sed -n 's/^good=//p' "$state_file")
    failed=$(sed -n 's/^failed=//p' "$state_file")
fi
save_state() {
    as_deck mkdir -p "$(dirname "$state_file")"
    printf 'key=%s\ngood=%s\nfailed=%s\n' "$state_key" "$good" "$failed" | as_deck tee "$state_file" >/dev/null
}

selftest=1
if [[ -n "$USER_WLR_RENDERER" ]]; then
    candidates=("$USER_WLR_RENDERER"); selftest=0
elif [[ -z "$RENDER_NODE" ]]; then
    candidates=(pixman); selftest=0
else
    candidates=(gles2 vulkan)
fi
order=()
[[ -n "$good" ]] && order+=("$good")
for r in "${candidates[@]}"; do
    [[ " $good $failed " == *" $r "* ]] || order+=("$r")
done
if [[ ${#order[@]} -eq 0 ]]; then
    log "WARNING: every renderer failed the capture self-test earlier (delete $state_file to retest)"
    order=("${candidates[0]}"); selftest=0
fi

for i in "${!order[@]}"; do
    r=${order[$i]}
    export WLR_RENDERER=$r
    last=$(( i == ${#order[@]} - 1 ))
    if ! start_sway; then
        log "sway failed to start with renderer $r"
        failed+=" $r"; save_state
        if (( last )); then log "ERROR: sway could not start with any renderer"; exit 1; fi
        continue
    fi
    log "sway is up on ${WAYLAND_DISPLAY} (renderer: $r)"
    start_steam
    start_sunshine
    if (( ! selftest )); then
        break
    fi
    if capture_selftest; then
        log "capture self-test: renderer $r OK"
        good=$r; save_state
        break
    fi
    failed+=" $r"; good=""; save_state
    if [[ "${RENDERER_FALLBACK:-0}" != "1" ]]; then
        log "ERROR: capture self-test FAILED with renderer $r: sway could not import Sunshine's"
        log "       capture buffer, so streams will show no picture. Please report this log."
        break
    fi
    if (( last )); then
        log "ERROR: capture self-test failed with every renderer (${order[*]}); streams will show no picture."
        log "       Please report this with the log. Keeping $r running so the web UI stays reachable."
        break
    fi
    log "capture self-test: renderer $r FAILED (sway could not import Sunshine's capture buffer); trying ${order[$((i + 1))]}"
    stop_stack
done
log "Sunshine web UI: https://<host-ip>:47990"

trap 'log "stopping"; kill -TERM $SUNSHINE_PID $SWAY_PID $PIPEWIRE_PID $SEATD_PID 2>/dev/null; exit 0' TERM INT
wait -n $SUNSHINE_PID $SWAY_PID $PIPEWIRE_PID $SEATD_PID
log "a core service exited; stopping container"
exit 1
