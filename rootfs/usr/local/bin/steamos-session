#!/bin/bash
# Sunshine runs this when a Moonlight client starts an app, with
# SUNSHINE_CLIENT_WIDTH/HEIGHT/FPS set. It sizes the display to the client and
# makes sure the right session is up (steamos-session-manager runs it):
#   steamos-session            Gaming Mode ("Steam Big Picture" in Moonlight)
#   steamos-session desktop    Desktop Mode ("Desktop" in Moonlight)
# Gaming Mode restarts only if the resolution changed, so reconnecting from
# the same device is instant. The mode is also kept in the home volume, so
# the next container start boots Gaming Mode at it and the first connection
# doesn't restart Steam either.
set -uo pipefail

W=${SUNSHINE_CLIENT_WIDTH:-1920}
H=${SUNSHINE_CLIENT_HEIGHT:-1080}
R=${SUNSHINE_CLIENT_FPS:-60}
mode="${W}x${H}@${R}"
state=/run/user/1000/steamos-session
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-1}
mkdir -p "$state"

swaymsg -q -- output HEADLESS-1 mode --custom "${W}x${H}@${R}Hz"
echo "$mode" > "$state/mode"
saved=/home/deck/.config/steamos-docker/client-mode
[[ "$(cat "$saved" 2>/dev/null)" == "$mode" ]] || { mkdir -p "${saved%/*}" && echo "$mode" > "$saved"; }

want=gamescope
[[ "${1:-}" == desktop ]] && want=plasma
current=$(cat "$state/current" 2>/dev/null)

# Woken up after Steam's Shut Down: the manager starts the wanted session.
if [[ -e "$state/off" ]]; then
    echo "$want" > "$state/next"
    rm -f "$state/off"
    exit 0
fi

if [[ "$current" != "$want" ]]; then
    exec steamos-session-control switch "$want"
fi
if [[ "$want" == gamescope && "$(cat "$state/running-mode" 2>/dev/null)" != "$mode" ]]; then
    exec steamos-session-control restart
fi
exit 0
