#!/bin/bash
# Resize the headless display to the Moonlight client's resolution and make
# sure Steam Big Picture (in gamescope) is running at that size.
# Sunshine calls this with SUNSHINE_CLIENT_WIDTH/HEIGHT/FPS set. If Steam is
# already running at that size it's left alone, so reconnecting from the same
# device is instant.
set -uo pipefail

W=${SUNSHINE_CLIENT_WIDTH:-1920}
H=${SUNSHINE_CLIENT_HEIGHT:-1080}
R=${SUNSHINE_CLIENT_FPS:-60}
mode="${W}x${H}@${R}"
state=/run/user/1000/steamos-session.mode
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-1}

swaymsg -q -- output HEADLESS-1 mode --custom "${W}x${H}@${R}Hz"

if pgrep -u "$(id -u)" -x gamescope >/dev/null && [[ "$(cat "$state" 2>/dev/null)" == "$mode" ]]; then
    exit 0
fi

if pgrep -u "$(id -u)" -x gamescope >/dev/null; then
    # Ask Steam to exit cleanly first so it doesn't lose settings/cloud saves.
    steam -shutdown >/dev/null 2>&1 || true
    for _ in $(seq 30); do pgrep -u "$(id -u)" -x steam >/dev/null || break; sleep 1; done
    pkill -u "$(id -u)" -x gamescope || true
    sleep 1
fi

mkdir -p /home/deck/.local/state
echo "$mode" > "$state"
# shellcheck disable=SC2086
setsid -f gamescope -e -f \
    -W "$W" -H "$H" -w "$W" -h "$H" -r "$R" \
    --xwayland-count 2 \
    -- steam ${STEAM_ARGS:--gamepadui -steamos3} \
    >>/home/deck/.local/state/steamos-session.log 2>&1 </dev/null
