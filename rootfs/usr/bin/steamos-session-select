#!/bin/bash
# SteamOS's session switcher, for the container's session manager
# (steamos-session-manager). Steam runs "steamos-session-select plasma" for
# Switch to Desktop; the desktop's Return to Gaming Mode runs it with
# "gamescope". Takes SteamOS's session names:
#   gamescope                     Gaming Mode
#   plasma, plasma-wayland,       Desktop Mode for this session only; Gaming
#   plasma-x11                    Mode comes back after logging out
#   plasma-persistent, ...        Desktop Mode until changed
#   --restart                     restart the current session (Steam's Restart)
#   --off                         stop it until the next Moonlight connection
set -uo pipefail

state=/run/user/1000/steamos-session
persist=/home/deck/.config/steamos-docker/session

# Steam may run this as root through a polkit helper.
if [[ $(id -u) -eq 0 ]]; then
    exec sudo -u deck -H XDG_RUNTIME_DIR=/run/user/1000 "$0" "$@"
fi
mkdir -p "$state" "$(dirname "$persist")"

case "${1:-}" in
    gamescope)
        echo gamescope > "$state/next"; rm -f "$persist" ;;
    plasma|plasma-wayland|plasma-x11|desktop)
        echo plasma > "$state/next"; rm -f "$persist" ;;
    plasma-persistent|plasma-wayland-persistent|plasma-x11-persistent)
        echo plasma > "$state/next"; echo plasma > "$persist" ;;
    --restart)
        cp "$state/current" "$state/next" 2>/dev/null || true ;;
    --off)
        touch "$state/off" ;;
    *)
        echo "usage: $0 gamescope|plasma[-wayland|-x11][-persistent]|--restart|--off" >&2
        exit 1 ;;
esac

# The manager ends the current session and starts the next one.
pid=$(cat "$state/manager.pid" 2>/dev/null)
if [[ -z "$pid" ]] || ! kill -USR1 "$pid" 2>/dev/null; then
    echo "steamos-session-select: the session manager isn't running" >&2
    exit 1
fi
exit 0
